# Public browser destinations. These URLs are intentionally available to visitors.
VITE_DAILY_PRAYER_URL=https://example.com/daily-prayer
VITE_WEEKLY_PRAYER_WHATSAPP_URL=https://chat.whatsapp.com/your-invite-code
VITE_GIVING_URL=https://example.com/give

# Outreach Call Centre (callcentre/schema.sql). Project Settings > API in
# Supabase. Both are safe in the browser -- they are the public project URL
# and anon key, never the service-role key. RLS in schema.sql protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Google Apps Script configuration. Do not add VITE_ to these names.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_TOKEN=replace-with-a-long-random-secret

# Server-only Termii bulk SMS configuration. Obtain the base URL from your Termii dashboard.
TERMII_API_KEY=replace-with-your-rotated-termii-api-key
TERMII_BASE_URL=https://your-termii-base-url
TERMII_SENDER_ID=Harvesters
TERMII_SMS_CHANNEL=generic

# Termii Email Product Notification configuration. Create a template containing {{message}}.
TERMII_EMAIL_CONFIGURATION_ID=your-termii-email-configuration-id
TERMII_EMAIL_TEMPLATE_ID=your-termii-email-template-id

# Optional: lets automation scripts call the bulk-SMS/email endpoints without an admin login.
# Not required for the admin dashboard itself, which uses admin accounts instead. Use a long random value.
ADMIN_BROADCAST_TOKEN=replace-with-a-long-random-secret

# Initial admin dashboard account, created the first time the server starts.
# If ADMIN_PASSWORD is left unset, a random password is generated and printed once to the server console.
ADMIN_NAME=Launch Admin
ADMIN_EMAIL=admin@harvestersng.org
ADMIN_PASSWORD=replace-with-a-strong-password
